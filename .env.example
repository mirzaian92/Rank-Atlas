# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://rankatlas:rankatlas@localhost:5432/rankatlas?schema=public"

# 32-byte key (base64) used to encrypt DataForSEO credentials saved from the Settings page.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Optional: DataForSEO credentials from env. These take precedence over credentials saved in Settings.
# Server-side only. Never prefix these with NEXT_PUBLIC_.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Master switch for live (paid) DataForSEO requests. While "false", every tool serves labelled mock data.
DATAFORSEO_LIVE_ENABLED="false"

# Comma-separated tool ids allowed to call DataForSEO when live mode is enabled.
# Integrate one tool at a time, e.g. "domain-overview".
DATAFORSEO_LIVE_TOOLS=""

# Optional: use the DataForSEO sandbox (free, returns dummy data) instead of the production API.
DATAFORSEO_USE_SANDBOX="false"
